{
  "name": "wastelens-ai",
  "version": "1.0.0",
  "description": "WASTELENS AI — Autonomous Food Waste & Inventory Intelligence",
  "private": true,
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace=server\" \"npm run dev --workspace=client\"",
    "build": "npm run build --workspace=client",
    "start": "npm run start --workspace=server",
    "setup": "npm install && npm run db:setup --workspace=server"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
