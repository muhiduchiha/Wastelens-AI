# WASTELENS AI Environment Variables
# Copy this to server/.env and fill in your values

PORT=3001
NODE_ENV=development
DATABASE_URL=file:./dev.db

# Gemini Model selection (default is gemini-3.1-flash-lite for high free quota & speed)
# Other options: gemini-flash-latest, gemini-3.8-flash
GEMINI_MODEL=gemini-3.1-flash-lite

# Option A: Comma-separated list of keys (Auto-Rotates & Failovers across all 10 keys!)
# GEMINI_API_KEYS=AIzaSyA...,AIzaSyB...,AIzaSyC...,AIzaSyD...

# Option B: Individual numbered keys (up to 10 or 20 keys)
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_API_KEY_4=
GEMINI_API_KEY_5=
GEMINI_API_KEY_6=
GEMINI_API_KEY_7=
GEMINI_API_KEY_8=
GEMINI_API_KEY_9=
GEMINI_API_KEY_10=

# Option C: Single key fallback (works backwards-compatible)
GEMINI_API_KEY=
